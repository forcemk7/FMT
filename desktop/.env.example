# Copy to .env.local (gitignored — never commit real values) and fill in
# once the Supabase project exists. See:
# FMT/scrum/tickets/T290-minimal-functional-telemetry.md
#
# NEXT_PUBLIC_ prefix is required for Next.js to inline these into the
# client build — they end up in the compiled bundle either way (the
# Supabase publishable key, sb_publishable_..., is meant to be public;
# security is enforced by the table's RLS policy, not by hiding this key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
